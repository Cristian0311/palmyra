{
  "name": "palmyra",
  "private": true,
  "version": "1.3.3",
  "main": "main.electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/write-version.mjs && vite build && node scripts/build-web-bundle.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:admin": "vite build --config admin/vite.config.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-admin",
    "lint": "tsc --noEmit",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "audit:architecture:strict": "node scripts/architecture-audit.mjs --strict",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integrity": "node scripts/integrity-smoke.mjs",
    "test:pwa:offline": "node scripts/pwa-offline-smoke.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "desktop:dist": "npm run build:desktop && electron-builder --win nsis --publish never",
    "build:desktop": "npm run build && esbuild server.ts --bundle --platform=node --format=cjs --external:sharp --external:vite --outfile=dist/desktop-server.cjs && esbuild main.electron.cjs --bundle --platform=node --format=cjs --target=node20 --external:electron --external:sharp --external:vite --outfile=dist/desktop-main.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "description": "PALMYRA POS · CRM y punto de venta offline-first",
  "author": "PALMYRA"
}
