<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cu.palmyra.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- El escáner del Punto de Venta usa la cámara vía getUserMedia.
         La cámara es opcional: sin ella la app sigue funcionando con el
         lector Bluetooth o la entrada manual. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Instalar el APK de actualización verificado (Android 8+ lo exige). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Respaldo cifrado en Descargas públicas solo en Android 9 o anterior:
         en API 29+ se escribe con MediaStore y este permiso no se declara. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- allowBackup=false: la base SQLite con los datos del negocio y la clave
         de licencia no viajan en respaldos de ADB/nube. El tráfico externo es
         solo HTTPS (network_security_config); el servidor local de la WebView
         conserva una excepción explícita para 127.0.0.1/localhost.

         El hub de la red local habla HTTP, pero eso NO cambia este manifiesto:
         desde targetSdk 24 la network_security_config tiene prioridad sobre
         usesCleartextTraffic, y el APK que habla con el hub se compila aparte
         (build-apk.sh con la opción LAN) con el overlay res-lan, que solo permite
         cleartext en esa variante no publicada en Releases. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Palmyra">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlace de acceso de dispositivo que genera el propietario
                 (src/services/deviceAccess.ts): palmyra://device-access?token=...
                 Abre la app instalada en lugar del navegador y MainActivity
                 carga la ruta local /device-access. Solo VIEW: los intents de
                 instalación del APK (content://) no coinciden con este filtro. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="palmyra" android:host="device-access" />
            </intent-filter>

            <!-- App Link https: el mismo enlace servido por la web
                 (https://palmyracrm.onrender.com/device-access?token=...).
                 autoVerify exige https://palmyracrm.onrender.com/.well-known/assetlinks.json
                 con el paquete cu.palmyra.app y la huella del certificado de firma. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="palmyracrm.onrender.com"
                    android:pathPrefix="/device-access" />
            </intent-filter>
        </activity>

        <!-- Solo entrega el APK de actualización ya verificado al instalador
             del sistema mediante un content:// temporal; no está exportado y
             no permite leer otros archivos de la aplicación. -->
        <provider
            android:name=".UpdateApkProvider"
            android:authorities="cu.palmyra.app.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
